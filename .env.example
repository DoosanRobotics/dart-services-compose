# Simulator SDK version (sdk2 ~ sdk7, sdk7_1 = sdk7.1 for Dart-Platform v3.7.1)
SDK_VERSION=sdk7_1

# Robot model
# Options: M0609, M0617, M1013, M1509, A0509, A0912, H2017, H2515, E0509, P3020
ROBOT_MODEL=M1013

# Simulator resources
SIMULATOR_CPU=4
SIMULATOR_MEMORY=2g

# Simulator MAC address (controller serial number is derived from it).
# The default is fixed so the serial survives container restarts.
# Change it only if you run several simulators on one network, or need a different serial.
# Use a locally administered unicast address (first octet 02, 06, 0a, 0e, ...).
# SIM_MAC_ADDRESS=02:35:76:55:3c:90
